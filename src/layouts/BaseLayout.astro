---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  jsonLd?: any;
}

const { 
  title, 
  description, 
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  robots = 'index, follow',
  ogImage = '/og-image.png',
  jsonLd
} = Astro.props;

const absoluteOgImage = new URL(ogImage, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Geo Tags -->
    <meta name="geo.region" content="CA-BC" />
    <meta name="geo.placename" content="North Vancouver" />
    <meta name="geo.position" content="49.32305;-123.07229" />
    <meta name="ICBM" content="49.32305, -123.07229" />
    
    <!-- Google Consent Mode v2 Default (Denied) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
      gtag('set', 'url_passthrough', true);
    </script>
    
    <!-- Google Tag Manager / GA4 (Placeholder ID) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SGGM6T75JR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SGGM6T75JR');
    </script>

    <!-- Conversion Event Tracking -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var target = e.target.closest('a');
        if (!target) return;
        
        var isBookingLink = target.classList.contains('booking-link') || (target.href && target.href.includes('booking.scandinavianclinic.com'));
        var isPhoneLink = target.href && target.href.startsWith('tel:');
        var isEmailLink = target.href && target.href.startsWith('mailto:');
        
        if (isBookingLink || isPhoneLink || isEmailLink) {
          var eventName = isBookingLink ? 'booking_click' : (isPhoneLink ? 'phone_click' : 'email_click');
          if (typeof gtag === 'function') {
            gtag('event', eventName, {
              'page_path': window.location.pathname
            });
          }
        }
      });
    </script>

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
